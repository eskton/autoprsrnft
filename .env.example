# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# Твой Telegram id (узнать: @userinfobot). Несколько — через запятую
ALLOWED_USERS=123456789

# User-аккаунт Telegram (https://my.telegram.org -> API development tools)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Какие биржи подключать: portals, tonnel, mrkt (через запятую). Сейчас работает только Portals
MARKETS=portals

# Необязательно: прокси для запросов к биржам
# PROXY=http://user:pass@host:port

# Как часто опрашивать ленту, сек. При ответах 429 бот сам замедляется до MAX_POLL_INTERVAL
# и потом снова ускоряется
POLL_INTERVAL=0.4
MAX_POLL_INTERVAL=10
# Сколько секунд держать флор в памяти (новые лоты из ленты попадают в него сразу)
FLOOR_TTL=60

# Пороги уведомлений по умолчанию (потом меняются командами в боте)
MIN_PROFIT_TON=1
MIN_PROFIT_PCT=5
MAX_BUY_TON=0
# Что искать: backdrop (лот дешевле флора фона), model (перепродажа по флору модели), both
DEFAULT_MODE=both
# На сколько % лот должен быть дешевле флора того же фона
MIN_DISCOUNT_PCT=10

# Комиссии бирж — сверь с актуальными в самих маркетах
PORTALS_SELL_FEE=0.05
TONNEL_BUY_FEE=0.10
TONNEL_SELL_FEE=0.0
MRKT_SELL_FEE=0.05
