# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# Твой Telegram id (узнать: @userinfobot). Несколько админов — через запятую
ADMIN_IDS=123456789
# Адрес мини-аппа, обязательно https (например бесплатный поддомен DuckDNS)
WEBAPP_URL=https://petshop.duckdns.org/

# @CryptoBot -> Crypto Pay -> Create App -> API Token
CRYPTOPAY_TOKEN=12345:AA...
# true — тестовая сеть (@CryptoTestnetBot), false — настоящие деньги
CRYPTOPAY_TESTNET=false
# Чем можно оплатить счёт в рублях
CRYPTOPAY_ASSETS=USDT,TON,BTC
# Сколько секунд живёт счёт на оплату
INVOICE_TTL=3600
# Сколько неоплаченных счетов одновременно может быть у одного человека
MAX_ACTIVE_INVOICES=5

# Где слушает сервер мини-аппа (Caddy проксирует сюда https-запросы)
WEB_HOST=127.0.0.1
WEB_PORT=8080
DB_PATH=data/shop.db
